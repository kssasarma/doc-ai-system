# Copy to .env (gitignored) and adjust. Every value is optional — the defaults noted below
# apply when a variable is unset, so a plain `npm run dev` works with no .env at all.
# All values are read at BUILD time (Vite inlines them into the bundle); changing one requires
# a rebuild / dev-server restart.

# Base path the app is served under. Drives Vite's `base` (asset URLs), the react-router
# basename, and — via the Docker BASE_PATH build arg — the nginx redirect/alias locations.
# Use a leading slash; trailing slash optional. Default: /docs-inator/
VITE_BASE_PATH=/docs-inator/

# Documentation Bot API (Spring Boot service on port 8080).
# Default: http://localhost:8080. Set to an empty string to make the bundle call same-origin
# relative paths (what the production Docker build does — nginx proxies /api/** to the backends).
VITE_BACKEND_URL=http://localhost:8080

# Document Ingestor API (Spring Boot service on port 8081).
# Default: http://localhost:8081. Empty string = same-origin relative paths (see above).
VITE_INGESTOR_URL=http://localhost:8081

# --- Branding / UI (defaults come from src/config/app.json) ---

# Product name shown in the UI, the HTML <title>, and meta tags. Default: Docs-inator
#VITE_APP_TITLE=Docs-inator

# Tagline appended to the HTML <title> and meta tags. Default: AI-Powered Documentation Assistant
#VITE_APP_SUBTITLE=AI-Powered Documentation Assistant

# Longer description used in the HTML description/og:description meta tags.
#VITE_APP_DESCRIPTION=Get instant answers to your documentation questions with our intelligent chatbot

# <meta name="theme-color"> for the HTML shell. Default: #2563eb
#VITE_THEME_COLOR=#2563eb

# Max characters accepted by the chat message input. Default: 2000
#VITE_MAX_MESSAGE_LENGTH=2000
